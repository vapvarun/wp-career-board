{
  "title": "WP Career Board REST API",
  "description": "REST API for WP Career Board (Free). Namespaced under `wcb/v1`. WP Career Board Pro adds its own routes to the same namespace; those are catalogued in the Pro plugin's own spec.\n\nThis document is generated from the live route registrations and scoped to the routes this plugin registers, so it never includes routes from Pro or any other plugin on the same install.",
  "namespaces": [
    "wcb/v1"
  ],
  "version_constant": "WCB_VERSION",
  "servers": [
    {
      "url": "https://your-site.com/wp-json",
      "description": "Your WordPress site (replace with your domain)"
    }
  ],
  "contact": {
    "name": "Wbcom Designs",
    "url": "https://wbcomdesigns.com/"
  },
  "license": {
    "name": "GPL-2.0-or-later"
  },
  "security_schemes": {
    "appPassword": {
      "type": "http",
      "scheme": "basic",
      "description": "A WordPress Application Password (issue one with POST /wcb/v1/auth/app-password, or Users -> Profile -> Application Passwords). Send it as HTTP Basic auth."
    },
    "cookieNonce": {
      "type": "apiKey",
      "in": "header",
      "name": "X-WP-Nonce",
      "description": "For same-origin browser requests using the logged-in WordPress cookie: send the wp_rest nonce in the X-WP-Nonce header."
    }
  },
  "default_security": [
    {
      "appPassword": []
    },
    {
      "cookieNonce": []
    }
  ],
  "tags": {
    "jobs": "Jobs",
    "search": "Jobs",
    "applications": "Applications",
    "files": "Applications",
    "candidates": "Candidates",
    "employers": "Employers",
    "companies": "Employers",
    "account": "Account",
    "me": "Account",
    "users": "Account",
    "auth": "Account",
    "admin": "Admin",
    "import": "Admin",
    "settings": "Admin",
    "wizard": "Admin"
  },
  "request_bodies": {
    "/wcb/v1/applications/{id}/notes": {
      "methods": [
        "POST"
      ],
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "Note text, up to 5000 characters."
        }
      }
    },
    "/wcb/v1/applications/{id}/status": {
      "methods": [
        "POST",
        "PUT",
        "PATCH"
      ],
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "description": "Status slug, for example reviewing or rejected."
        },
        "note": {
          "type": "string",
          "description": "Optional message kept with the status change."
        }
      }
    },
    "/wcb/v1/candidates/{id}": {
      "methods": [
        "POST",
        "PUT",
        "PATCH"
      ],
      "properties": {
        "bio": {
          "type": "string",
          "description": "Profile bio."
        },
        "profile_visibility": {
          "type": "string",
          "description": "Who can see the profile: public or private."
        },
        "resume": {
          "type": "object",
          "description": "Full resume data object, replaces the stored one."
        },
        "resume_data": {
          "type": "object",
          "description": "Partial resume data, merged into the stored one."
        },
        "custom_fields": {
          "type": "object",
          "description": "Custom field values keyed by field key."
        }
      }
    },
    "/wcb/v1/employers": {
      "methods": [
        "POST"
      ],
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Company name."
        },
        "description": {
          "type": "string",
          "description": "Company description."
        },
        "hq": {
          "type": "string",
          "description": "Headquarters location."
        },
        "make_main": {
          "type": "boolean",
          "description": "Make this the main company of the account."
        }
      }
    },
    "/wcb/v1/employers/{id}": {
      "methods": [
        "POST",
        "PUT",
        "PATCH"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Company name."
        },
        "description": {
          "type": "string",
          "description": "Company description."
        },
        "hq": {
          "type": "string",
          "description": "Headquarters location."
        },
        "custom_fields": {
          "type": "object",
          "description": "Custom field values keyed by field key."
        }
      }
    },
    "/wcb/v1/jobs/{id}/apply": {
      "methods": [
        "POST"
      ],
      "properties": {
        "cover_letter": {
          "type": "string",
          "description": "Cover letter text."
        },
        "resume_id": {
          "type": "integer",
          "description": "Resume to attach."
        },
        "resume_attachment_id": {
          "type": "integer",
          "description": "An earlier uploaded CV of the applicant to reuse."
        },
        "guest_name": {
          "type": "string",
          "description": "Name, for a visitor who is not signed in."
        },
        "guest_email": {
          "type": "string",
          "description": "Email, for a visitor who is not signed in."
        },
        "custom_fields": {
          "type": "object",
          "description": "Custom field values keyed by field key."
        }
      }
    },
    "/wcb/v1/jobs": {
      "methods": [
        "POST"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "Job title."
        },
        "description": {
          "type": "string",
          "description": "Job description as HTML."
        },
        "remote": {
          "type": "boolean",
          "description": "Remote job."
        },
        "location_custom": {
          "type": "string",
          "description": "Free-text location, used when no location term fits."
        },
        "locations": {
          "type": "array",
          "description": "Location term ids or names."
        },
        "job_types": {
          "type": "array",
          "description": "Job type term ids or names."
        },
        "experience": {
          "type": "array",
          "description": "Experience term ids or names."
        },
        "tags": {
          "type": "array",
          "description": "Tag term ids or names."
        },
        "custom_fields": {
          "type": "object",
          "description": "Custom field values keyed by field key."
        }
      }
    },
    "/wcb/v1/jobs/{id}": {
      "methods": [
        "POST",
        "PUT",
        "PATCH"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "Job title."
        },
        "description": {
          "type": "string",
          "description": "Job description as HTML."
        },
        "remote": {
          "type": "boolean",
          "description": "Remote job."
        },
        "location_custom": {
          "type": "string",
          "description": "Free-text location, used when no location term fits."
        },
        "locations": {
          "type": "array",
          "description": "Location term ids or names."
        },
        "job_types": {
          "type": "array",
          "description": "Job type term ids or names."
        },
        "experience": {
          "type": "array",
          "description": "Experience term ids or names."
        },
        "tags": {
          "type": "array",
          "description": "Tag term ids or names."
        },
        "custom_fields": {
          "type": "object",
          "description": "Custom field values keyed by field key."
        }
      }
    }
  }
}
