msgctxt "block description"
msgid "Reactive job listings grid with infinite scroll and bookmark toggle."
msgstr "Reactieve vacaturelijst met oneindig scrollen en bladwijzer schakelen."

#: blocks/job-search-hero/block.json
msgctxt "block description"
msgid "Full-width job search form with optional filters. Horizontal or vertical layout."
msgstr "Vacaturezoekvorm op volledige breedte met optionele filters. Horizontale of verticale indeling."

#: blocks/job-search/block.json
msgctxt "block description"
