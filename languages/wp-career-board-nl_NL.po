msgctxt "block description"
msgid "Taxonomy filter dropdowns for the job listings grid."
msgstr "Taxonomie-filterkeuzemenu's voor de vacaturelijst."

#: blocks/job-form-simple/block.json
msgctxt "block description"
msgid "Single-page job posting form — every field on one screen, suitable for sidebars, modals, or partner pages where the multi-step wizard is overkill."
msgstr "Vacatuurformulier op één pagina - alle velden op één scherm, geschikt voor zijbalken, modale vensters of partnerpagina's waar de stapsgewijze wizard niet nodig is."

