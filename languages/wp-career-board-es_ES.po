msgstr "Los que cierran antes"

#: admin/class-admin-settings.php:757
#: blocks/job-listings/render.php:551
msgid "Highest salary"
msgstr "Salario más alto"

#: admin/class-admin-settings.php:758
#: blocks/company-archive/render.php:240
#: blocks/job-listings/render.php:552
#: templates/parts/archive-toolbar.php:77
msgid "Oldest first"
msgstr "Más antiguos primero"

#: admin/class-admin-settings.php:760
msgid "How job lists are ordered before a visitor picks a sort. Newest first lists featured jobs at the top. A keyword search always shows the best matches first."
msgstr "Cómo se ordenan las listas de empleos antes de que el visitante elija un orden. «Más recientes primero» muestra los empleos destacados arriba. Una búsqueda por palabra clave siempre muestra primero las mejores coincidencias."

#: admin/class-admin-settings.php:764
msgid "Default Salary Currency"
msgstr "Moneda de salario predeterminada"

