#!/bin/sh
# Reject AI attribution trailers. House rule: no Co-Authored-By: Claude,
# no Claude-Session, no "Generated with" footer — in any commit, ever.
# Added after 14 commits across the free/pro pair shipped with them anyway
# and a public force-push was needed to remove them (see CLAUDE.md).
if grep -qiE '^(Co-Authored-By:[[:space:]]*Claude|Claude-Session:)|Generated with \[?Claude' "$1"; then
	echo "commit-msg: refusing — message carries an AI attribution trailer." >&2
	echo "Strip Co-Authored-By: Claude / Claude-Session / 'Generated with Claude' and commit again." >&2
	exit 1
fi
