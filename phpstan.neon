includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    paths:
        - admin/
        - api/
        - auth/
        - blocks/
        - cli/
        - core/
        - import/
        - integrations/
        - modules/
        - wp-career-board.php
    excludePaths:
        analyseAndScan:
            - vendor/ (?)
            - node_modules/ (?)
        # Vendored SDKs are scanned (so their classes resolve) but not analysed.
        analyse:
            - libs/ (?)
    bootstrapFiles:
        - phpstan-bootstrap.php
    scanFiles:
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
        - vendor/php-stubs/wp-cli-stubs/wp-cli-tools-stubs.php
        - phpstan-buddypress-stubs.php
    scanDirectories:
        - libs/edd-sl-sdk/src/
    # BuddyPress objects carry dynamic properties.
    universalObjectCratesClasses:
        - BP_Groups_Group
        - BP_Notifications_Notification
        - BP_User_Query
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        - '#Function apply_filters invoked with#'
        - '#Function do_action invoked with#'
        - '#Variable \$\w+ might not be defined#'
        - '#Cannot access offset .* on mixed#'
